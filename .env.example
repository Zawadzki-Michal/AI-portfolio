# --- Contact form (app/api/contact) ---
# Optional: forward /collaborate form submissions to a webhook (Slack, Discord, Zapier, etc.)
CONTACT_WEBHOOK_URL=

# --- LinkedIn publish script (scripts/publish-to-linkedin.ts) ---
# Set as GitHub Actions secrets, not needed for local `next dev`.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
SITE_URL=https://your-portfolio.vercel.app

# --- Draft generation script (scripts/generate-draft.ts) ---
# OpenRouter (https://openrouter.ai/keys) — routed to a Claude model by default.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-4.5
RSS_FEEDS=
