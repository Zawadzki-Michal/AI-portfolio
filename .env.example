# --- Contact form (app/api/contact) ---
# Optional: forward /collaborate form submissions to a webhook (Slack, Discord, Zapier, etc.)
CONTACT_WEBHOOK_URL=

# --- LinkedIn publish script (scripts/publish-to-linkedin.ts) ---
# Set as GitHub Actions secrets, not needed for local `next dev`.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
SITE_URL=https://your-portfolio.vercel.app

# --- Draft generation script (scripts/generate-draft.ts) ---
# OpenRouter (https://openrouter.ai/keys) — routed to a Claude model by default.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-4.5
RSS_FEEDS=

# --- Post comments (components/Comments.tsx, app/api/comments) ---
# Readers sign in with LinkedIn (Auth.js) to comment; comments are stored in
# Postgres (Neon, via Vercel's Storage integration) and publish immediately.

# Auth.js session encryption — generate with `npx auth secret`.
AUTH_SECRET=

# LinkedIn OAuth app (developer.linkedin.com) with the "Sign In with LinkedIn
# using OpenID Connect" product added. Callback URL:
#   http://localhost:3000/api/auth/callback/linkedin   (local dev)
#   https://your-domain/api/auth/callback/linkedin      (production)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Neon/Vercel Postgres connection string (Vercel dashboard → Storage → create
# a Postgres database, or console.neon.tech directly). Run `npm run db:init`
# once against this to create the comments table.
DATABASE_URL=

# --- Error monitoring (Sentry, sentry.*.config.ts / instrumentation*.ts) ---
# Create a project at sentry.io (or self-hosted) and set its DSN here. Not a
# secret — it's fine to expose client-side, which is why it's NEXT_PUBLIC_.
# Leaving it unset disables Sentry entirely (no-op init), safe for local dev.
NEXT_PUBLIC_SENTRY_DSN=

# Only needed to upload source maps during `next build` for readable stack
# traces (Vercel dashboard → Sentry integration, or sentry.io → Settings →
# Auth Tokens with project:releases scope). Leave unset to skip upload.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
